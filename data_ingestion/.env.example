# =============================================================
# HEATWATCH — Data Ingestion Module
# Environment Configuration Template
# =============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================

# ── Database connection ────────────────────────────────────────
# Must point to the existing PostgreSQL/PostGIS database
# created by the database/ module.
DATABASE_URL=postgresql://heatwatch_user:change_me_strong_password@127.0.0.1:5433/heatwatch

# ── Dataset root directories ──────────────────────────────────
DATASET_ROOT=../dataset

FIRMS_RAW_PATH=../dataset/raw/firms
HISTORICAL_FIRMS_RAW_PATH=../dataset/raw/historical_firms
OSM_RAW_PATH=../dataset/raw/osm
LANDCOVER_RAW_PATH=../dataset/raw/landcover
INDUSTRIAL_RAW_PATH=../dataset/raw/industrial
SATELLITE_RAW_PATH=../dataset/raw/satellite

PROCESSED_DATA_ROOT=../dataset/processed
REJECTED_DATA_ROOT=../dataset/rejected

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=../data_ingestion/logs/ingestion.log

# ── Coordinate reference system ───────────────────────────────
DEFAULT_CRS=EPSG:4326

# ── Batch sizes for bulk database inserts ─────────────────────
FIRMS_BATCH_SIZE=1000
HISTORICAL_FIRMS_CHUNK_SIZE=50000
INDUSTRIAL_BATCH_SIZE=500

# ── FIRMS / NASA API (optional — for metadata only) ───────────
# Set only if you plan to fetch live FIRMS metadata.
# The ingestion module reads local CSV files by default.
FIRMS_MAP_KEY=

# ── Deduplication options ─────────────────────────────────────
# STRICT: skip any record that matches a unique constraint
# UPDATE: update safe metadata on constraint conflict
DEDUP_STRATEGY=STRICT

# ── Land-cover dataset identifier ─────────────────────────────
# Used as land_cover_source in the land_context table.
LANDCOVER_DATASET_ID=ESA_WorldCover_2021
LANDCOVER_RESOLUTION_M=10
