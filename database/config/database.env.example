# =============================================================
# HEATWATCH — Database Config Environment Template
# =============================================================
# Kept in database/config/ for tooling that reads from this path.
# The content mirrors database/.env.example intentionally.
# =============================================================

POSTGRES_DB=heatwatch
POSTGRES_USER=heatwatch_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

DATABASE_URL=postgresql://heatwatch_user:change_me_strong_password@localhost:5433/heatwatch

PGVECTOR_EMBEDDING_DIMENSION=1536
