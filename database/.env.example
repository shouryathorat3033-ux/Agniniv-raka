# =============================================================
# HEATWATCH — Database Environment Configuration Template
# =============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================

# ── PostgreSQL connection ──────────────────────────────────
POSTGRES_DB=heatwatch
POSTGRES_USER=heatwatch_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# ── Full connection URL (used by most clients/ORMs) ────────
# psycopg (v3) driver prefix:
DATABASE_URL=postgresql://heatwatch_user:change_me_strong_password@localhost:5433/heatwatch

# ── pgvector embedding dimension ──────────────────────────
# Default: 1536 (OpenAI text-embedding-3-small / ada-002)
# Change to 768 for Google gecko / BERT-base embeddings.
# WARNING: changing this after data has been inserted requires
#          dropping and recreating the rag_chunks.embedding column
#          and rebuilding all embeddings.
PGVECTOR_EMBEDDING_DIMENSION=1536

# ── Optional connection pool tuning ───────────────────────
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ── Development flags ─────────────────────────────────────
# Set DB_ECHO=true to print all SQL statements to stdout
DB_ECHO=false
